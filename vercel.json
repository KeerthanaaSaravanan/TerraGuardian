{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "services/api/data/dem/Copernicus_GLO_30_N27_E092.tif",
      "excludeFiles": "{node_modules/**,apps/**,tests/**,dist/**,docs/**,scripts/**,scratch/**,screenshots/**,.pytest_cache/**,.vercel/**,.vercel_python_packages/**,**/.env*,**/*.md,**/demo_accounts.py,**/data/uploads/**,.venv/**,venv/**,ENV/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
