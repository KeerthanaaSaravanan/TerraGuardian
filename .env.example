# ==============================================================================
# TerraGuardian AI — Unified Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - PUBLIC CONFIG: Variables prefixed with VITE_ are embedded into frontend assets
#   during build. Set these in Vercel project environment settings.
# - SECRET CONFIG: Never prefix with VITE_. Set these ONLY on the backend hosting
#   platform (Render, Railway, Fly.io, AWS, etc.). NEVER commit real secrets to Git.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND PUBLIC CONFIG (Vercel Build-time Environment Variables)
# ==============================================================================
# Optional API override. Leave unset for same-origin /api/v1 routing (including Vercel).
# Use a local URL only in a local-development-specific environment file.
VITE_API_URL=

# Public Citizen PWA cross-link (from Operations Centre login/navigation):
VITE_CITIZEN_SAFE_URL=https://terraguardian-safe.vercel.app

# Public MapLibre Style URL:
MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json


# ==============================================================================
# 2. BACKEND SERVER CONFIG (FastAPI)
# ==============================================================================
TERRAGUARDIAN_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Allowed CORS origins (comma-separated, NO wildcard '*' in production):
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://terraguardian-operations-centre.vercel.app,https://terraguardian-safe.vercel.app,https://terraguardian.vercel.app


# ==============================================================================
# 3. DATABASE CONFIG (PostgreSQL + asyncpg)
# ==============================================================================
# Managed PostgreSQL (Neon, Render, Supabase, AWS RDS, Railway):
# Scheme postgresql+asyncpg:// is required (standard postgres:// will be auto-normalized)
DATABASE_URL=postgresql+asyncpg://user:password@db.example.net:5432/terraguardian


# ==============================================================================
# 4. BACKEND AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
# Cryptographic secret for signing HS256 JWT tokens (generate a 64+ char random string):
SECRET_KEY=changeme-generate-a-cryptographically-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Optional SIH evaluation presets. Keep disabled outside an explicitly approved
# evaluation deployment. Passwords are server-only and must never use a VITE_ prefix.
DEMO_AUTH_ENABLED=false
DEMO_OPERATOR_PASSWORD=
DEMO_ASSESSMENT_PASSWORD=
DEMO_PATROL_PASSWORD=
DEMO_MAGISTRATE_PASSWORD=
DEMO_REVIEWER_PASSWORD=


# ==============================================================================
# 5. PERSISTENT OBJECT STORAGE (Citizen Hazard Photographs)
# ==============================================================================
# Options: local (development default) | s3 | object_storage (production persistent)
STORAGE_PROVIDER=local

# Required if STORAGE_PROVIDER is s3 / object_storage:
# Supports AWS S3, Cloudflare R2, Supabase Storage, Google Cloud Storage S3, MinIO
S3_BUCKET_NAME=terraguardian-evidence
S3_REGION_NAME=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=


# ==============================================================================
# 6. PUSH NOTIFICATION INFRASTRUCTURE (Firebase Cloud Messaging)
# ==============================================================================
FIREBASE_PROJECT_ID=terraguardian-ai
FCM_SERVER_KEY=


# ==============================================================================
# 7. MULTIMODAL AI & COMPUTER VISION
# ==============================================================================
# Google Gemini Vision API key for automated landslide photograph screening
GEMINI_API_KEY=


# ==============================================================================
# 8. GEOCODING & BASEMAP PROVIDERS
# ==============================================================================
MAPTILER_API_KEY=
