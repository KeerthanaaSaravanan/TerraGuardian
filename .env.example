# ============================================================
# TerraGuardian AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---------- General ----------
TERRAGUARDIAN_ENV=development
LOG_LEVEL=INFO

# ---------- API Server ----------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Database (PostgreSQL + PostGIS) ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=terraguardian
DATABASE_USER=terraguardian
DATABASE_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ---------- Security ----------
SECRET_KEY=changeme-generate-a-real-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---------- Map Tiles ----------
MAPTILER_API_KEY=
MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# ---------- External Data Connectors ----------
# IMD (India Meteorological Department)
IMD_API_BASE_URL=
IMD_API_KEY=

# MOSDAC
MOSDAC_API_BASE_URL=

# Copernicus / Sentinel
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Bhuvan
BHUVAN_API_BASE_URL=

# ---------- Storage ----------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ---------- Redis (future) ----------
# REDIS_URL=redis://localhost:6379/0
