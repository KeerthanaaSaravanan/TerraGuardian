<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TERRAGUARDIAN SAFE"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NER Citizen Early Warning Platform"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="LIVE FCM"
                android:textColor="@color/primary_light"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stale Data / Offline Banner -->
        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#f59e0b"
            android:textColor="#ffffff"
            android:padding="8dp"
            android:textSize="11sp"
            android:text="⚠ OPERATING OFFLINE · DATA MAY BE STALE"
            android:layout_marginBottom="12dp" />

        <!-- 1. Core Safety Status Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSafetyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#10b981"
            app:cardBackgroundColor="@color/surface_dark"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL CLEAR"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 NO ACTIVE HAZARDS NEAR YOU"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvLocationDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27.245°N, 92.540°E (West Kameng, Arunachal Pradesh)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Active Warning Details Box -->
                <LinearLayout
                    android:id="@+id/layoutActiveWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:background="#20000000"
                    android:padding="10dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvWarningRationale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnIAmSafe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ I AM SAFE (ACKNOWLEDGE)"
                        android:backgroundTint="@color/primary"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Emergency Action Card: WHAT SHOULD YOU DO? -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_card"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ WHAT SHOULD YOU DO NOW?"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▸ Proceed with standard mountain transit caution.\n▸ Report newly observed slope cracks or road shoulder subsidence.\n▸ Avoid parking vehicles directly beneath steep excavated rockfaces."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. What Changed Timeline -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_card"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 WHAT CHANGED IN YOUR CORRIDOR?"
                    android:textColor="@color/primary_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWhatChanged"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• IMD AWS tipping-bucket rain gauges reporting stable levels.\n• No physical slope failure detected along your 15km corridor envelope."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Corridor Road Statuses -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_card"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚧 CORRIDOR ROAD STATUS (BRO VERIFIED)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NH-13 (BCT Corridor KM-42): CAUTION\nOne-way traffic operational. PWD machinery clearing roadside debris."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action: Report Hazard Button -->
        <Button
            android:id="@+id/btnReportHazard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📸 REPORT HAZARD OBSERVATION →"
            android:backgroundTint="@color/primary"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <!-- Emergency Hotlines -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="EMERGENCY HOTLINES:\nDDMA: 1077 | Police: 112 | SDMA: 1070 | BRO: 03778-222044"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
